# Android 11 imports this as /init.${ro.hardware}.rc. The CM13 init.qcom.rc
# is not installed. Without a mount_all here, userdata stays an empty
# directory, post-fs remounts / read-only, and zygote aborts creating
# /data/dalvik-cache.

on fs
    # ueventd only creates /dev/block/platform/soc.0/${ro.boot.bootdevice}.
    # Other clients still look up /dev/block/bootdevice.
    wait /dev/block/platform/soc.0/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc.0/${ro.boot.bootdevice} /dev/block/bootdevice
    mount_all /vendor/etc/fstab.qcom
    # While cont_splash_enabled is set, lcd-backlight only stores the
    # level and returns. The panel current is the WLED sink, full scale
    # 4095, left there by LK. 512 is about an eighth.
    write /sys/class/leds/wled/brightness 512
    write /sys/class/leds/lcd-backlight/brightness 40
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    write /sys/class/android_usb/android0/idVendor 18D1
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}

# The HIDL supplicant copies its conf here on startup. The directory is
# not created by the generic rc. Without it, STA setup fails and Wi-Fi
# turns itself back off.
on post-fs-data
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

# The generic configfs=0 rules only program adb and accessory. This kernel
# is the legacy android_usb gadget. f_ffs aliases "adb", so a composition
# that contains adb is written as "mtp,adb" and the driver binds ffs.
# Do not force sys.usb.config here. init.usb.rc copies persist.sys.usb.config
# on boot, and UsbDeviceManager kicks through "none" before the new mode.
on boot
    write /sys/class/leds/wled/brightness 512
    write /sys/class/leds/lcd-backlight/brightness 40
    # userdebug starts /system/bin/sh on the UART. init.svc.console=running
    # makes the lock screen say the serial console is hurting performance.
    stop console

# Bring-up: the stored screen_off_timeout is 30 s. Keep the panel awake on
# USB/AC power so the first frames stay visible.
on property:sys.boot_completed=1
    exec_background - system system -- /system/bin/settings put global stay_on_while_plugged_in 7

on property:sys.usb.config=mtp && property:sys.usb.configfs=0
    stop adbd
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4EE1
    write /sys/class/android_usb/android0/functions mtp
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=0
    stop adbd
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4EE2
    write /sys/class/android_usb/android0/functions mtp,adb
    write /sys/class/android_usb/android0/enable 1
    start adbd
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=ptp && property:sys.usb.configfs=0
    stop adbd
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4EE5
    write /sys/class/android_usb/android0/functions ptp
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=ptp,adb && property:sys.usb.configfs=0
    stop adbd
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4EE6
    write /sys/class/android_usb/android0/functions ptp,adb
    write /sys/class/android_usb/android0/enable 1
    start adbd
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=rndis && property:sys.usb.configfs=0
    stop adbd
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4EE3
    write /sys/class/android_usb/android0/functions rndis
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=rndis,adb && property:sys.usb.configfs=0
    stop adbd
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4EE4
    write /sys/class/android_usb/android0/functions rndis,adb
    write /sys/class/android_usb/android0/enable 1
    start adbd
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=midi && property:sys.usb.configfs=0
    stop adbd
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4EE8
    write /sys/class/android_usb/android0/functions midi
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=midi,adb && property:sys.usb.configfs=0
    stop adbd
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4EE9
    write /sys/class/android_usb/android0/functions midi,adb
    write /sys/class/android_usb/android0/enable 1
    start adbd
    setprop sys.usb.state ${sys.usb.config}
